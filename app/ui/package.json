{
  "name": "maxed-ui",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json --config ./svelte.config.js",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:ui": "vitest run --config vitest.config.ts --configLoader runner",
    "check:tests": "svelte-check --tsconfig ./tsconfig.test.json --config ./svelte.config.js",
    "tauri": "cd ../src-tauri && tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "svelte": "^5.57.3"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "jsdom": "^26.1.0",
    "svelte-check": "^4.7.8",
    "typescript": "~5.9.3",
    "vite": "^6.4.5",
    "vitest": "^5.1.0"
  }
}
